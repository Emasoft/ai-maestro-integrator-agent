#!/usr/bin/env bash
# Pre-push hook — delegates to publish.py --gate for all quality checks.
# Follows the PSS (perfect-skill-suggester) pattern: one script, two modes.
#
# NOTE: the ACTIVE hook in this repo is .githooks/pre-push (core.hooksPath),
# an ancestry gate that refuses any push not routed through publish.py. This
# file is the --install-hook source and is currently inert. The secret scan
# canon (CPV v5.21.1) wanted on feature pushes is unnecessary here — the
# ancestry gate refuses feature pushes outright — and the RELEASE path gets
# its scan as publish.py gate stage G5 (adopted 2026-09-29 from the same
# canon, fail-closed, scoped to commits since origin/main).
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
if command -v uv &> /dev/null; then
    uv run python scripts/publish.py --gate
else
    python3 scripts/publish.py --gate
fi
exit $?
